# =============================================================================
# Bien moi truong cho docker-compose.prod.yml (trien khai Internet). KHONG commit file that.
#   cp deploy/env.prod.example .env.prod   (.env.prod da nam trong .gitignore)
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================================

# --- Ten mien / HTTPS (Caddy) -------------------------------------------------
PUBLIC_DOMAIN=hocsinh.example.vn
ACME_EMAIL=admin@example.vn
# CADDY_VERSION=2.8-alpine
# Dia chi dang nhap in tren phieu tai khoan hoc sinh. Mac dinh https://PUBLIC_DOMAIN/login.
# PUBLIC_LOGIN_URL=https://hocsinh.example.vn/login

# --- Image ---------------------------------------------------------------------
IMAGE_TAG=prod
# UI_BUILD_CONTEXT=../education_ui

# --- Oracle (chay tren may chu, KHONG mo cong 1521 ra Internet) ----------------
DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/ORCL
DB_USERNAME=EDUCATION
# Doi mat khau mac dinh truoc khi len Internet.
DB_PASSWORD=

# --- JWT: BAT BUOC, ngau nhien >= 32 byte (vd: openssl rand -base64 48) ---------
JWT_SECRET=
# JWT_ACCESS_TOKEN_TTL=15m
# JWT_REFRESH_TOKEN_TTL=7d

# --- CORS: de trong (UI va API cung origin https://PUBLIC_DOMAIN). Chi https:// --
CORS_ALLOWED_ORIGINS=

# --- Phieu thu -----------------------------------------------------------------
RECEIPT_CENTER_NAME=
RECEIPT_CENTER_ADDRESS=
RECEIPT_CENTER_PHONE=

# --- Gioi han tan suat (HTTP 429 + Retry-After). Mac dinh nhu application.yml ---
# AUTH_RATE_LIMIT_LOGIN_PER_IP=200           # rong vi ca trung tam dung chung 1 IP NAT; ten dang nhap van 10
# AUTH_RATE_LIMIT_LOGIN_PER_USERNAME=10
# RATE_LIMIT_CHANGE_PASSWORD_PER_USER=5      # /api/v1/auth/change-password, cua so 15m
# RATE_LIMIT_PORTAL_PER_USER=300             # /api/v1/portal/**, cua so 5m
# RATE_LIMIT_PORTAL_PER_IP=0                 # 0 = khong gioi han theo IP (NAT)
# RATE_LIMIT_UPLOAD_PER_USER=60              # request multipart, cua so 1h
# RATE_LIMIT_UPLOAD_PER_IP=300

# --- Nhat ky he thong (SYS_AUDIT_LOGS, migration V17_3) -------------------------
# AUDIT_ENABLED=true

# --- Volume file dinh kem (sao luu bang scripts/ops/backup.*) -------------------
# UPLOADS_VOLUME=education-prod-outputs

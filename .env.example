IMAGE_TAG=prod
BUILD_VERSION=local
GIT_SHA=unknown
SERVER_PORT=8090
UI_PORT=8088
DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/ORCL
DB_USERNAME=EDUCATION
DB_PASSWORD=EDUCATION
# JWT: bắt buộc đặt secret ngẫu nhiên >= 32 ký tự khi chạy prod (ví dụ: openssl rand -base64 48).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=education-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

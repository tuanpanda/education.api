IMAGE_TAG=prod
BUILD_VERSION=local
GIT_SHA=unknown
SERVER_PORT=8090
UI_PORT=8088
# Địa chỉ đăng nhập công khai in trên phiếu tài khoản học sinh (container ui ghi vào env.js khi khởi động).
# Để trống = địa chỉ trang đang mở + /login (in từ http://192.168.1.10:8088 thì phiếu ghi địa chỉ LAN đó).
# PUBLIC_LOGIN_URL=https://hocsinh.trungtam.vn/login
# CORS: origin (phân tách dấu phẩy) được gọi API cross-origin. Để trống khi UI gọi /api qua nginx cùng origin.
# Ví dụ UI IIS ở máy khác: CORS_ALLOWED_ORIGINS=http://192.168.1.10:8081,https://edu.example.vn
CORS_ALLOWED_ORIGINS=
DB_URL=jdbc:oracle:thin:@//host.docker.internal:1521/ORCL
DB_USERNAME=EDUCATION
DB_PASSWORD=EDUCATION
# JWT: BẮT BUỘC đặt secret ngẫu nhiên riêng >= 32 byte (ví dụ: openssl rand -base64 48).
# Để trống thì docker compose báo lỗi; secret dev/test/ví dụ bị profile prod từ chối khi khởi động.
JWT_SECRET=
JWT_ISSUER=education-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
# Cookie đăng nhập HttpOnly (access / refresh token). Secure=true: chỉ gửi qua HTTPS (http://localhost vẫn được).
# Mở UI qua HTTP bằng IP / tên máy (ví dụ http://192.168.1.10:8088) thì phải đặt false hoặc dùng HTTPS.
AUTH_COOKIE_SECURE=true
# Strict (mặc định) hoặc Lax. UI và API phải cùng site.
AUTH_COOKIE_SAME_SITE=Strict
# Tùy chọn chống dò mật khẩu / phiên đăng nhập. docker-compose.yml đã truyền các biến này vào service api với
# mặc định như dưới: bỏ dấu # và đổi giá trị nếu cần.
# JWT_REFRESH_REUSE_GRACE=10s                 # nhiều tab làm mới token cùng lúc (0s = tắt)
# AUTH_LOCKOUT_MAX_FAILED_ATTEMPTS=5          # mỗi 5 lần sai -> khóa tạm thời
# AUTH_LOCKOUT_BASE_DURATION=15m              # lần khóa đầu; lần sau gấp đôi
# AUTH_LOCKOUT_MAX_DURATION=24h               # trần thời gian khóa
# AUTH_RATE_LIMIT_ENABLED=true                # HTTP 429 cho /api/v1/auth/login, /refresh
# AUTH_RATE_LIMIT_WINDOW=5m
# AUTH_RATE_LIMIT_LOGIN_PER_IP=200
# AUTH_RATE_LIMIT_LOGIN_PER_USERNAME=10
# AUTH_RATE_LIMIT_REFRESH_PER_IP=120
# AUTH_RATE_LIMIT_REFRESH_PER_USER=60
# SERVER_FORWARD_HEADERS_STRATEGY=native      # IP thật từ X-Forwarded-For (sau nginx của UI); none = tắt
# Giới hạn tần suất tổng quát (HTTP 429 + Retry-After; 0 = tắt chiều đó). Biến khác: xem application.yml.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_CHANGE_PASSWORD_PER_USER=5       # /api/v1/auth/change-password, cửa sổ 15m
# RATE_LIMIT_PORTAL_PER_USER=300              # /api/v1/portal/**, cửa sổ 5m
# RATE_LIMIT_UPLOAD_PER_USER=60               # request multipart, cửa sổ 1h
# AUDIT_ENABLED=true                          # nhật ký hệ thống SYS_AUDIT_LOGS (migration V17_3)
# APP_INTERNET_FACING=false                   # true chỉ khi ra Internet (docker-compose.prod.yml, docs/deploy-internet.md)
# Phiếu thu: thông tin trung tâm in ở đầu phiếu (để trống = tên chủ tài khoản ngân hàng đang dùng).
RECEIPT_CENTER_NAME=
RECEIPT_CENTER_ADDRESS=
RECEIPT_CENTER_PHONE=
